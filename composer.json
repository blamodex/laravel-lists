{
    "name": "blamodex/laravel-lists",
    "description": "A lightweight Laravel package to manage lists with polymorphic relationships",
    "keywords": [
        "laravel",
        "lists",
        "polymorphic",
        "eloquent",
        "wishlist",
        "favorites"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Blamodex",
            "email": "blackmage.codex@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3",
        "larastan/larastan": "^3.0",
        "squizlabs/php_codesniffer": "4.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Blamodex\\Lists\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blamodex\\Lists\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blamodex\\Lists\\ListsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "XDEBUG_MODE=off php -d xdebug.mode=off vendor/bin/phpunit 2>&1 | grep -v 'Xdebug: \\[Step Debug\\]' || true",
        "test:coverage": "XDEBUG_MODE=coverage php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-html coverage 2>&1 | grep -v 'Xdebug: \\[Step Debug\\]' || true",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf",
        "analyze": "XDEBUG_MODE=off php -d xdebug.mode=off -d memory_limit=512M vendor/bin/phpstan analyse",
        "quality": [
            "@lint",
            "@analyze",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
